# Copia este fichero a .env. Todo es opcional.
LASTFM_API_KEY=
LASTFM_USERNAME=
DISCOGS_TOKEN=
# Búsquedas de YouTube simultáneas; más es más rápido, pero con más riesgo de bloqueo
YT_WORKERS=2
# Contraseña del panel ⚙: imprescindible para ver o cambiar credenciales desde la web
SETTINGS_PASSWORD=
# Selector en la barra lateral para saltar a otros servicios de este mismo host, si responden
# CHARTS_SWITCH=Sellos:8792,Artistas:8793
